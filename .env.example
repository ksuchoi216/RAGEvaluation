# 필수: API 키와 계정에서 사용 가능한 모델명을 입력하세요.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EVAL_OPENAI_MODEL=
EVAL_ANTHROPIC_MODEL=

# 선택: 비워두면 openai:/{EVAL_OPENAI_MODEL}을 사용합니다.
EVAL_MLFLOW_MODEL=

# MLflow 추적 서버. 스킴을 생략하면 http://를 사용합니다.
mlflow_url=localhost:30001
# MLFLOW_TRACKING_URI가 설정되어 있으면 mlflow_url보다 우선합니다.
